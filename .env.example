# Storefront environment — copy to .env (production) or .env.local (dev override).
# .env.local takes precedence over .env when present, and is gitignored so it
# stays local to your machine.

# ---- REQUIRED ----

# The UltimateScrapperV2 backend that serves /store/:slug/* API and the live
# product-refresh endpoint. Switch this between local + deployed for testing.
#
#   local dev backend:   http://localhost:3002
#   deployed (Render):   https://ultimatescrapperv2.onrender.com
#   deployed (AWS IP):   https://43.204.135.214.sslip.io
VITE_BASE_URL=http://43.204.135.214:3002

# ---- OPTIONAL ----

# Legacy: kept for backward compatibility with the original Aqua Watch code
# paths. Currently the storefront reads VITE_BASE_URL for the live-refresh
# call too, so this can be blank. Set only if you want live-refresh to hit a
# separate server (e.g. a private AWS box) different from the main backend.
# VITE_LIVE_URL=https://43.204.135.214.sslip.io

# Which vendor to render when running locally at http://localhost:5175/
# (no ?store= param and no cached slug). Leave blank to force the shopper to
# pick a store via ?store=slug — the platform-neutral behaviour.
# VITE_DEV_STORE=aqua-watch

# Template used by the portal to build a shareable storefront link for a
# hosted site. {slug} is replaced with the vendor's slug.
#   local dev:           http://localhost:5175/?store={slug}
#   production subdomain: https://{slug}.yourplatform.com
# The portal reads this from portal-app-clean/.env.local (NOT this file);
# it's only listed here for reference.
